# Copie ce fichier en .env localement, ou configure ces variables dans Render.
# Ne jamais commiter le fichier .env avec les vraies valeurs.

# Authentification des accès jeux (au moins un compte requis)
GAME_USERS_JSON={"gryphon.agency":"remplace-par-un-mot-de-passe-unique-et-long"}

# Compte TikTok utilisé par le bot et la surveillance live
TIKTOK_USERNAME=gryphon.agency
LIVE_ALERT_TIKTOK_USERNAME=gryphon.agency

# Connexion TikTok Login Kit pour protéger les jeux gratuits par pseudo vérifié.
# Dans TikTok for Developers, activer Login Kit et le scope user.info.profile.
# Enregistrer cette URL comme redirect URI pour l’application TikTok.
# Renseigner les trois valeurs comme variables d’environnement Render; ne pas commiter le secret réel.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://jeu6boite.onrender.com/auth/tiktok/callback

# Optionnel : persistance des données de compte Render
# GAME_DATA_FILE=/var/data/gryphon-accounts.json

# Optionnel : clés VAPID pour les notifications web push
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Optionnel : intégration PayPal (activer selon votre environnement)
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
